#!/bin/bash
# Builds a throwaway Laima for a test by hand (docs/testing.md): a copy of the core with a canned vault and a toy
# project, outside every home folder.
# Usage: make-fixture <slot> [--seed <name>] [--multiplexer <name>]
#   <slot>          N or slot-N: the folder $LAIMA_TESTING_HOME/slot-N, by default
#                   /var/tmp/<core folder>-testing-<user>/slot-N; anything else is refused, and so is an existing
#                   folder this script did not build
#   --seed          a scenario's starting state from docs/testing/fixture/seeds/<name>.sh, on top of the base, which has
#                   nothing pending
#   --multiplexer   the multiplexer the copy's local/setup.md names (default: the one this shell runs in)
# The slot holds laima/ (the core's files as they stand in the working tree, new ones git does not ignore included,
# without docs/testing and the skills' and companion skills' cases.md and evals, committed as a git repository, plus
# the canned local/), the toy project
# and work/ for task folders.
# Prints the slot's path.
set -euo pipefail
CORE="$(cd "$(dirname "$0")/../.." && pwd -P)"; F="$CORE/docs/testing/fixture"; TOY=tallyfile
# Outside every home folder: Claude Code reads instruction files from each folder above a session's, the user's
# among them. Outside /tmp, which the system empties.
HOME_DIR="${LAIMA_TESTING_HOME:-/var/tmp/$(basename "$CORE")-testing-$(id -un)}"
die() { echo "make-fixture: $*" >&2; exit 2; }

[ $# -ge 1 ] || die "usage: make-fixture <slot> [--seed <name>] [--multiplexer <name>]"
case "$1" in
  [0-9]|[0-9][0-9]) n="$1" ;;
  slot-[0-9]|slot-[0-9][0-9]) n="${1#slot-}" ;;
  *) die "not a slot: $1 (give N or slot-N)" ;;
esac; shift; n=$((10#$n))
SEED=""; MUX=""
[ -n "${HC_TERMINAL_ID:-}" ] && MUX=herdr; [ -n "${CMUX_WORKSPACE_ID:-}" ] && MUX=cmux; [ -n "${REX_SESSION:-}" ] && MUX=rex
while [ $# -gt 0 ]; do case "$1" in
  --seed|--multiplexer) [ $# -ge 2 ] || die "$1 needs a value"
    if [ "$1" = --seed ]; then SEED="$2"; else MUX="$2"; fi; shift ;;
  *) die "unknown argument: $1" ;;
esac; shift; done
[ -n "$MUX" ] || die "give --multiplexer: this shell runs in none"
[ -f "$CORE/adapters/multiplexers/$MUX.md" ] || die "no adapter adapters/multiplexers/$MUX.md"
[ -z "$SEED" ] || [ -f "$F/seeds/$SEED.sh" ] || die "no seed docs/testing/fixture/seeds/$SEED.sh"

# Refused before anything is created: the deepest folder that exists, resolved, must not be in the home folder.
case "$HOME_DIR" in /*) ;; *) die "LAIMA_TESTING_HOME must be an absolute path" ;; esac
hh="$(cd "$HOME" && pwd -P)"; p="$HOME_DIR"
while [ ! -d "$p" ]; do p="$(dirname "$p")"; done
inside="$HOME_DIR is inside the home folder; set LAIMA_TESTING_HOME outside it"
case "$(cd "$p" && pwd -P)/" in "$hh"/*) die "$inside" ;; esac
(umask 077; mkdir -p "$HOME_DIR"); home="$(cd "$HOME_DIR" && pwd -P)"
case "$home/" in "$hh"/*) die "$inside" ;; esac
S="$home/slot-$n"
[ ! -e "$S" ] || [ -f "$S/.laima-eval-slot" ] || die "refusing $S: it exists and make-fixture did not build it"

rm -rf "$S"; mkdir -p "$S"/{laima,work}; : > "$S/.laima-eval-slot"
LAIMA="$S/laima"; LOCAL="$LAIMA/local"; TOYDIR="$S/$TOY"; SLOT="$S"
TODAY="$(date +%F)"; YDAY="$(date -v-1d +%F)"; DAY2="$(date -v-2d +%F)"; NOW="$(date +%H:%M)"
export GIT_AUTHOR_NAME=Sam GIT_AUTHOR_EMAIL=sam@example.invalid
export GIT_COMMITTER_NAME=Sam GIT_COMMITTER_EMAIL=sam@example.invalid
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1

# The core, without docs/testing and the skills' trigger cases and evals (the companion skills' beside their adapters
# too): a test session should not read how it is being tested.
(cd "$CORE" && git ls-files -z --cached --others --exclude-standard | tr '\0' '\n' |
  grep -v -E '^docs/testing(\.md$|/)|^(\.agents/skills|adapters/multiplexers)/[^/]+/(cases\.md$|evals/)') |
  (cd "$CORE" && while IFS= read -r f; do
     [ -e "$f" ] || [ -L "$f" ] || continue
     mkdir -p "$LAIMA/$(dirname "$f")"; cp -P "$f" "$LAIMA/$f"; done)

# The toy project: two commits on main, the second from yesterday's finished task.
mkdir -p "$TOYDIR"
cp "$F/toy/tallyfile.py" "$F/toy/test_tallyfile.py" "$F/toy/sample.txt" "$TOYDIR/"
cp "$F/toy/project-instructions.md" "$TOYDIR/AGENTS.md"
git -C "$TOYDIR" init -q -b main
git -C "$TOYDIR" add -A && git -C "$TOYDIR" commit -q -m "Add tallyfile"
git -C "$TOYDIR" checkout -q -b readme && cp "$F/toy/README.md" "$TOYDIR/" && git -C "$TOYDIR" add README.md
git -C "$TOYDIR" commit -q -m "Add a README" && git -C "$TOYDIR" checkout -q main
git -C "$TOYDIR" merge -q --ff-only readme && git -C "$TOYDIR" branch -q -d readme
README="$(git -C "$TOYDIR" rev-parse --short HEAD)"

# The canned vault: every file under fixture/local, placeholders filled, names too.
mux_line="- $MUX; adapter \`adapters/multiplexers/$MUX.md\`"
harness_rows="$( v="$(claude --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)" &&
    [ -n "$v" ] && echo "| Claude Code | $v | \`adapters/harnesses/claude-code.md\` |"
  v="$(codex --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)" &&
    [ -n "$v" ] && echo "| Codex CLI | $v | \`adapters/harnesses/codex.md\` |"
  v="$(agy --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)" &&
    [ -n "$v" ] && echo "| Antigravity CLI | $v | \`adapters/harnesses/agy.md\` |"; true)"
fill() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      @MULTIPLEXER_LINE@) printf '%s\n' "$mux_line" ;;
      @HARNESS_ROWS@) [ -z "$harness_rows" ] || printf '%s\n' "$harness_rows" ;;
      *) line="${line//@SLOT@/$S}"; line="${line//@TOYPATH@/$TOYDIR}"; line="${line//@TOY@/$TOY}"
         line="${line//@TODAY@/$TODAY}"; line="${line//@YDAY@/$YDAY}"; line="${line//@DAY2@/$DAY2}"
         line="${line//@NOW@/$NOW}"; line="${line//@README@/$README}"; printf '%s\n' "$line" ;;
    esac
  done
}
(cd "$F/local" && find . -type f ! -name .DS_Store) | while IFS= read -r f; do
  to="${f#./}"; to="${to//@TOY@/$TOY}"; to="${to//@TODAY@/$TODAY}"; to="${to//@YDAY@/$YDAY}"
  to="${to//@YMONTH@/${YDAY%-*}}"
  mkdir -p "$LOCAL/$(dirname "$to")"; fill < "$F/local/$f" > "$LOCAL/$to"
done
mkdir -p "$LOCAL"/{work,log,knowledge,projects}

# toy_branch <branch> <subject> <command...>: for a seed, a branch off main with one commit made by the command in
# the toy project; prints the commit's short id. Each part is chained, since a seed calls it inside $(...), where
# set -e does not stop the build; a command that changes nothing fails the commit and so the build.
toy_branch() {
  local b="$1" m="$2" c; shift 2
  git -C "$TOYDIR" checkout -q -b "$b" main &&
    (cd "$TOYDIR" && "$@") >/dev/null &&
    git -C "$TOYDIR" add -A && git -C "$TOYDIR" commit -q -m "$m" >/dev/null &&
    c="$(git -C "$TOYDIR" rev-parse --short HEAD)" && git -C "$TOYDIR" checkout -q main &&
    ! git -C "$TOYDIR" merge-base --is-ancestor "$c" main && echo "$c"
}
[ -z "$SEED" ] || . "$F/seeds/$SEED.sh"

# The core copy as a repository: the authoring and wrap-up skills read git there. local/ is ignored by its own
# .gitignore, as in the real core.
git -C "$LAIMA" init -q -b main
git -C "$LAIMA" add -A && git -C "$LAIMA" commit -q -m "Laima core (test copy)"
echo "$S"
