#!/usr/bin/env bash
# Is the installed Herdr still what the herdr skill was verified on? Compares the versions of herdr-app and hc
# with SKILL.md's `Verified:` line (exact tokens) and re-runs read-only probes behind its facts.
# Exit 0: same Herdr versions, every probe holds. A harness (claude, codex, agy) that is installed in another
# version than the line names is printed as a `note:` and does not fail the check; one the line does not name gets
# no note: harnesses update far more often than the live cases can be re-run, and their release notes say what
# changed.
# Exit 1: herdr-app or hc changed version, or a probe changed; every probe is listed.
# Exit 2: herdr-app, hc or jq is missing.
command -v jq >/dev/null || { echo "drift: jq is not on PATH"; exit 2; }
dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd) || exit 2
line=$(grep -m1 '^Verified:' "$dir/SKILL.md")

# verified TOOL: the first version that follows TOOL in the Verified line.
verified() { grep -Eo "(^|[ ,])$1 [0-9]+\.[0-9]+\.[0-9]+[^ ,]*" <<<"$line" | head -1 | sed 's/.* //; s/\.$//'; }
# installed CMD...: the first version-looking word of a successful CMD, else nothing.
installed() {
  local out
  out=$("$@" 2>/dev/null) || return 0
  grep -Eo '[0-9]+\.[0-9]+\.[0-9]+[^ ,)]*' <<<"$out" | head -1
}

same=1 missing=() report=() notes=()
for t in herdr-app hc; do
  have=$(installed "$t" --version) want=$(verified "$t")
  [ -n "$have" ] || missing+=("$t")
  [ "$have" = "$want" ] || same=0
  report+=("$t ${have:-?}")
done
[ ${#missing[@]} -eq 0 ] || { echo "drift: no version from ${missing[*]}"; exit 2; }
for t in claude codex agy; do
  have=$(installed "$t" --version) want=$(verified "$t")
  [ -z "$have" ] || [ -z "$want" ] || [ "$have" = "$want" ] || notes+=("note: $t is $have, verified on $want; read its release notes")
done

# cmd NAME [ARG]: "yes" when `herdr-app commands` lists NAME (with argument ARG), else "no".
cmd() {
  herdr-app commands | jq -r --arg n "$1" --arg a "${2-}" '
    map(select(.name == $n)) |
    if length == 0 then "no" elif $a == "" or any(.[0].args[]?; .name == $a) then "yes" else "no" end'
}
# cmd_like ERE: the command names matching ERE, or "none".
cmd_like() {
  herdr-app commands | jq -r --arg re "$1" '[.[].name | select(test($re))] | join(" ") | if . == "" then "none" else . end'
}

names=() changed=()
# probe NAME has|lacks ERE COMMAND...: COMMAND must succeed, and its output must (has) or must not (lacks)
# match ERE, any case. A failing COMMAND counts as changed.
probe() {
  local name=$1 mode=$2 pattern=$3 out rc hit=lacks
  shift 3
  [[ " ${names[*]} " == *" $name "* ]] || names+=("$name")
  out=$("$@" 2>&1)
  rc=$?
  if [ $rc -ne 0 ]; then changed+=("$name: '$*' failed with exit $rc"); return; fi
  grep -Eiq -- "$pattern" <<<"$out" && hit=has
  local verb='now matches'
  [ "$mode" = has ] && verb='no longer matches'
  [ "$hit" = "$mode" ] || changed+=("$name: '$*' $verb /$pattern/")
}

probe placement has '^yes$' cmd terminal.keep place
probe placement has '^yes$' cmd tab.new focus
probe placement has '^yes$' cmd tab.new space
probe placement has 'outlive-parent' hc run --help
probe placement has 'no-parent' hc run --help
probe adoption has 'herdr\.space=<id>' herdr-app --skill
probe send has '\-\-if <STATUS>' hc send --help
probe send has 'message to you also ends it' hc wait --help
probe send has 'wait for the turn this send started' hc send --help
probe notify has '^none$' cmd_like 'notif|toast'
probe close has '^yes$' cmd tab.close confirmed
if command -v claude >/dev/null; then
  probe modes has 'allow-dangerously-skip-permissions' claude --help
  probe modes has '"plan"' claude --help
fi
if command -v codex >/dev/null; then
  probe modes has 'no-daemon' codex --help
  probe modes has 'dangerously-bypass-approvals-and-sandbox' codex --help
fi
probe templates lacks '"name":"(codex|claude|agy)"' hc templates --json
probe docs has 'herdr-core|hc ' herdr-app --help

[ ${#notes[@]} -eq 0 ] || printf '%s\n' "${notes[@]}"
if [ $same = 1 ] && [ ${#changed[@]} -eq 0 ]; then
  echo "${report[*]} match Verified; probes hold: ${names[*]}"
  exit 0
fi
[ $same = 1 ] || echo "installed ${report[*]} differ from $line; re-run evals/cases.md in the source checkout (a test copy leaves it out)"
for name in "${names[@]}"; do
  detail=$(printf '%s\n' "${changed[@]}" | grep "^$name: " | sed "s/^$name: //" | paste -sd ';' -)
  if [ -n "$detail" ]; then echo "changed $name: $detail"; else echo "holds $name"; fi
done
exit 1
